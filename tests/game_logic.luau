local Logic = require("../src/shared/GameLogic")
local Catalog = require("../src/shared/Catalog")
local Config = require("../src/shared/Config")
local Games = require("../src/shared/Minigames")
local serde = require("@lune/serde")
local fs = require("@lune/fs")
local tests = {}
local function test(name, fn)
    local ok, message = pcall(fn)
    table.insert(tests, { name = name, passed = ok, error = ok and nil or tostring(message) })
    if not ok then error(name .. ": " .. tostring(message)) end
end
local id = Catalog[1].id
local function rolls(acceptance, timing, delay) return { acceptance = acceptance, timing = timing, delay = delay or 0.5 } end
test("All 34 characters have four valid variant probabilities", function()
    assert(#Catalog == 34)
    for _, c in Catalog do for _, v in Config.Variants do local p = Logic.chance(c.id, v.id); assert(p and p >= 0.05 and p <= 0.9) end end
end)
test("Variant changes probability without rerolling an existing like", function()
    assert(Logic.chance(id, "classic") > Logic.chance(id, "gold"))
    assert(Logic.chance(id, "gold") > Logic.chance(id, "neon"))
    assert(Logic.chance(id, "neon") > Logic.chance(id, "cosmic"))
end)
test("Passing creates no match or pending response", function()
    local p = Logic.newProfile(1000); assert(Logic.swipe(p, id, "classic", false, 1000, rolls(0, 0)))
    assert(p.totalPasses == 1 and next(p.matches) == nil and Logic.publicSnapshot(p, 1000).pending == 0)
end)
test("Immediate reciprocal like creates one match", function()
    local p = Logic.newProfile(1000); local ok, result = Logic.swipe(p, id, "classic", true, 1000, rolls(0, 0))
    assert(ok and result == "matched" and p.matches[Logic.key(id, "classic")].stage == 1)
end)
test("Immediate decline never becomes a match", function()
    local p = Logic.newProfile(1000); local ok, result = Logic.swipe(p, id, "classic", true, 1000, rolls(1, 0))
    assert(ok and result == "declined"); assert(#Logic.resolvePending(p, 1e9) == 0 and next(p.matches) == nil)
end)
test("Delayed reciprocal like resolves only after its due time", function()
    local p = Logic.newProfile(1000); assert(Logic.swipe(p, id, "classic", true, 1000, rolls(0, 1, 0)))
    assert(#Logic.resolvePending(p, 1044) == 0 and next(p.matches) == nil)
    assert(#Logic.resolvePending(p, 1045) == 1 and p.matches[Logic.key(id, "classic")])
    assert(#Logic.resolvePending(p, 1100) == 0)
end)
test("Offline JSON roundtrip preserves a delayed outcome", function()
    local p = Logic.newProfile(1000); Logic.swipe(p, id, "classic", true, 1000, rolls(0, 1, 1))
    local loaded = Logic.normalizeProfile(serde.decode("json", serde.encode("json", p)), 3000)
    assert(#Logic.resolvePending(loaded, 3000) == 1 and #Logic.publicSnapshot(loaded, 3000).matches == 1)
end)
test("A never-response remains unmatched after any absence", function()
    local p = Logic.newProfile(1000); Logic.swipe(p, id, "classic", true, 1000, rolls(1, 1))
    assert(#Logic.resolvePending(p, 1100) == 0 and Logic.publicSnapshot(p, 1100).pending == 1)
    assert(#Logic.resolvePending(p, 100000000) == 0 and next(p.matches) == nil)
    assert(p.swipes[Logic.key(id, "classic")].status == "unanswered")
end)
test("Duplicate swipe cannot reroll or increment totals", function()
    local p = Logic.newProfile(1000); Logic.swipe(p, id, "classic", true, 1000, rolls(1, 1))
    local ok, errorCode = Logic.swipe(p, id, "classic", true, 2000, rolls(0, 0))
    assert(not ok and errorCode == "already_swiped" and p.totalLikes == 1 and next(p.matches) == nil)
end)
test("Public state contains no hidden acceptance or schedule", function()
    local p = Logic.newProfile(1000); Logic.swipe(p, id, "classic", true, 1000, rolls(0, 1))
    local encoded = serde.encode("json", Logic.publicSnapshot(p, 1000))
    assert(not encoded:find("willMatch") and not encoded:find("dueAt") and not encoded:find("expiresAt"))
end)
test("Unknown profiles are rejected", function()
    local p = Logic.newProfile(0); assert(not Logic.swipe(p, "unknown", "classic", true, 0, rolls(0, 0)))
    assert(not Logic.swipe(p, id, "unknown", true, 0, rolls(0, 0)))
end)
test("Three mini-games must be completed in order", function()
    local p = Logic.newProfile(1000); Logic.swipe(p, id, "classic", true, 1000, rolls(0, 0))
    local key = Logic.key(id, "classic"); assert(not Logic.finishStage(p, key, 2, 1, 1000))
    assert(not Logic.finishStage(p, key, 1, 0.5, 1000)); assert(p.matches[key].stage == 1)
    assert(Logic.finishStage(p, key, 1, 0.75, 1100)); assert(Logic.finishStage(p, key, 2, 4/6, 1200))
    local ok, result = Logic.finishStage(p, key, 3, 1, 1300); assert(ok and result == "album" and p.album[key])
    assert(not Logic.finishStage(p, key, 3, 1, 1400)); assert(#Logic.publicSnapshot(p, 1400).album == 1)
end)
test("Signal scoring uses server-time target bounds", function()
    assert(Games.callHit(0, 0.5)); assert(not Games.callHit(0, 0.1))
    assert(math.abs(Games.callPosition(2 / Games.callSpeed, 0.2) - 0.2) < 0.0001)
    assert(math.abs(Games.callPosition(1 / Games.callSpeed, 0.2) - 0.8) < 0.0001)
end)
test("Different variants have separate histories", function()
    local p = Logic.newProfile(0); assert(Logic.swipe(p, id, "classic", false, 0, rolls(0, 0)))
    assert(Logic.swipe(p, id, "gold", true, 0, rolls(0, 0))); assert(p.totalLikes == 1 and p.totalPasses == 1)
end)
test("Sent-like history reveals statuses and timestamps, never hidden outcomes", function()
    local p = Logic.newProfile(1000)
    Logic.swipe(p, id, "classic", true, 1100, rolls(0, 1))
    Logic.swipe(p, id, "gold", true, 1200, rolls(1, 1))
    Logic.swipe(p, id, "neon", false, 1300, rolls(0, 0))
    local state = Logic.publicSnapshot(p, 1400)
    assert(#state.sentLikes == 2 and state.sentLikes[1].variantId == "gold" and state.sentLikes[1].likedAt == 1200)
    assert(state.sentLikes[1].status == "pending")
    local encoded = serde.encode("json", state.sentLikes)
    assert(not encoded:find("willMatch") and not encoded:find("dueAt") and not encoded:find("expiresAt"))
    Logic.resolvePending(p, 100000)
    state = Logic.publicSnapshot(p, 100000)
    assert(state.sentLikes[1].status == "unanswered" and state.sentLikes[2].status == "matched")
end)
test("Only the last pass can be undone; likes and their outcomes cannot be rerolled", function()
    local p = Logic.newProfile(1000)
    assert(not Logic.undoPass(p))
    Logic.swipe(p, id, "classic", false, 1000, rolls(0, 0))
    assert(Logic.publicSnapshot(p, 1000).lastPass.characterId == id)
    local ok, restored = Logic.undoPass(p)
    assert(ok and restored.variantId == "classic" and p.totalPasses == 0 and not p.swipes[Logic.key(id,"classic")])
    assert(not Logic.undoPass(p))
    Logic.swipe(p, id, "classic", false, 1000, rolls(0, 0))
    Logic.swipe(p, id, "gold", false, 1001, rolls(0, 0))
    ok, restored = Logic.undoPass(p); assert(ok and restored.variantId == "gold" and p.totalPasses == 1)
    Logic.swipe(p, id, "gold", true, 1002, rolls(1, 1))
    assert(not Logic.undoPass(p) and p.swipes[Logic.key(id,"classic")].status == "passed")
    assert(p.swipes[Logic.key(id,"gold")].willMatch == false and p.totalLikes == 1)
end)
test("Practice improves best scores without duplicating the story or changing a like", function()
    local p = Logic.newProfile(1000); Logic.swipe(p,id,"classic",true,1000,rolls(0,0))
    local key = Logic.key(id,"classic")
    assert(not Logic.practiceStage(p,key,1,1))
    Logic.finishStage(p,key,1,.75,1001);Logic.finishStage(p,key,2,4/6,1002);Logic.finishStage(p,key,3,.75,1003)
    local before = p.revision
    local ok, result = Logic.practiceStage(p,key,1,1)
    assert(ok and result.improved and result.best == 1 and p.revision == before+1)
    assert(p.matches[key].stage == 4 and p.album[key].scores["1"] == 1 and p.totalLikes == 1)
    ok,result=Logic.practiceStage(p,key,1,0)
    assert(ok and not result.improved and result.best == 1 and not result.passed)
    assert(#Logic.publicSnapshot(p,2000).album == 1 and p.swipes[key].status == "matched")
    assert(not Logic.practiceStage(p,key,4,1) and not Logic.practiceStage(p,key,1,1.1))
end)
test("Warmer delivery speeds up accepted replies without changing acceptance", function()
    local accepted = Logic.decide(id,"classic",1000,rolls(0,.50,.5))
    local declined = Logic.decide(id,"classic",1000,rolls(1,.50,.5))
    assert(accepted.willMatch and accepted.status == "matched" and accepted.delivery == "immediate")
    assert(not declined.willMatch and declined.status == "pending" and declined.delivery == "delayed")
    assert(Logic.decide(id,"classic",1000,rolls(0,.9,.5)).status == "pending")
    assert(Logic.decide(id,"classic",1000,rolls(1,.1,.5)).status == "declined")
end)
test("A selfie requires a completed story and preserves the chosen place and player", function()
    local p = Logic.newProfile(1000); Logic.swipe(p,id,"classic",true,1000,rolls(0,0))
    local key = Logic.key(id,"classic")
    assert(not Logic.recordSelfie(p,key,"park",123,"{}",1001))
    Logic.finishStage(p,key,1,1,1001); Logic.finishStage(p,key,2,1,1002)
    assert(not Logic.recordSelfie(p,key,"park",123,"{}",1003))
    Logic.finishStage(p,key,3,.75,1004)
    assert(Logic.recordSelfie(p,key,"cafe",123,'{"version":1}',1005))
    local a = Logic.publicSnapshot(p,1006).album[1]
    assert(a.locationId == "cafe" and a.avatarUserId == 123 and a.avatarSnapshot == '{"version":1}' and a.selfieAt == 1005)
    assert(p.matches[key].dateLocationId == "cafe" and a.scores["3"] == .75)
end)
test("Invalid selfie inputs cannot mutate a completed story", function()
    local p = Logic.newProfile(1000); Logic.swipe(p,id,"classic",true,1000,rolls(0,0))
    local key = Logic.key(id,"classic")
    for stage = 1,3 do Logic.finishStage(p,key,stage,1,1000+stage) end
    local revision = p.revision
    assert(not Logic.recordSelfie(p,key,"secret-room",123,"{}",1005))
    assert(not Logic.recordSelfie(p,key,"park",123.5,"{}",1005))
    assert(not Logic.recordSelfie(p,key,"park",123,string.rep("x",64001),1005))
    assert(p.revision == revision and p.album[key].locationId == nil)
end)
test("Another successful date updates its selfie without duplicating or lowering the story", function()
    local p = Logic.newProfile(1000); Logic.swipe(p,id,"classic",true,1000,rolls(0,0))
    local key = Logic.key(id,"classic")
    for stage = 1,3 do Logic.finishStage(p,key,stage,1,1000+stage) end
    Logic.recordSelfie(p,key,"park",123,"old-look",1005)
    local ok, result = Logic.practiceStage(p,key,3,.75); assert(ok and result.passed and not result.improved)
    Logic.recordSelfie(p,key,"rooftop",123,"new-look",2000)
    local state = Logic.publicSnapshot(p,2001)
    assert(#state.album == 1 and state.album[1].scores["3"] == 1 and state.album[1].locationId == "rooftop")
    assert(state.album[1].avatarSnapshot == "new-look" and state.album[1].selfieAt == 2000 and state.totalLikes == 1)
end)
test("Invalid completion scores never advance or corrupt a match", function()
    local p = Logic.newProfile(1000); Logic.swipe(p,id,"classic",true,1000,rolls(0,0))
    local key = Logic.key(id,"classic")
    local before = serde.encode("json", p)
    for _, score in { -1, 1.01, math.huge, -math.huge, 0/0, "1", false } do
        local ok, reason = Logic.finishStage(p,key,1,score,1001)
        assert(not ok and reason == "invalid_score")
        assert(serde.encode("json", p) == before)
    end
    assert(not Logic.finishStage(p,key,1,nil,1001))
    assert(Logic.validSavedProfile(p) and p.matches[key].stage == 1)
end)
test("Unread and unfinished matches stay ahead of completed stories", function()
    local p = Logic.newProfile(0)
    for index, variant in { "classic", "gold", "neon", "cosmic" } do
        Logic.swipe(p,id,variant,true,500-index*100,rolls(0,0))
    end
    local completedKey = Logic.key(id,"classic")
    for stage = 1,3 do Logic.finishStage(p,completedKey,stage,1,500+stage) end
    p.matches[Logic.key(id,"gold")].unread = false
    local matches = Logic.publicSnapshot(p,1000).matches
    assert(matches[1].variantId == "neon" and matches[2].variantId == "cosmic")
    assert(matches[3].variantId == "gold" and matches[4].variantId == "classic")
    for _, match in p.matches do match.matchedAt = 100 end
    matches = Logic.publicSnapshot(p,1000).matches
    assert(matches[1].variantId == "cosmic" and matches[2].variantId == "neon")
    assert(matches[3].variantId == "gold" and matches[4].variantId == "classic")
end)
test("The latest successful selfie returns to the front of the album", function()
    local p = Logic.newProfile(0)
    for index, variant in { "classic", "gold" } do
        Logic.swipe(p,id,variant,true,index*100,rolls(0,0))
        for stage = 1,3 do Logic.finishStage(p,Logic.key(id,variant),stage,1,index*100+stage) end
    end
    assert(Logic.publicSnapshot(p,500).album[1].variantId == "gold")
    Logic.recordSelfie(p,Logic.key(id,"classic"),"rooftop",123,"look",600)
    local state = Logic.publicSnapshot(p,601)
    assert(#state.album == 2 and state.album[1].variantId == "classic")
    assert(state.album[1].completedAt == 103 and state.album[1].selfieAt == 600)
    Logic.recordSelfie(p,Logic.key(id,"gold"),"park",123,"look",600)
    state = Logic.publicSnapshot(p,601)
    assert(state.album[1].variantId == "classic" and state.album[2].variantId == "gold")
end)
fs.writeFile("prototype/evidence/logic-tests.json", serde.encode("json", { passed = #tests, tests = tests }, true))
print("Passed " .. #tests .. " meaningful logic tests")
