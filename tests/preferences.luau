local Preferences = require("../src/shared/Preferences")
local Logic = require("../src/shared/GameLogic")
local Catalog = require("../src/shared/Catalog")
local serde = require("@lune/serde")
local fs = require("@lune/fs")
local tests = {}
local function test(name, fn)
    local ok, err = pcall(fn)
    table.insert(tests,{name=name,passed=ok,error=ok and nil or tostring(err)})
    assert(ok,name .. ": " .. tostring(err))
end
local function encoded(value) return serde.encode("json",value) end

test("Legacy profiles keep progress and receive normal sound and motion defaults",function()
    local p = Logic.newProfile(1000); p.preferences = nil
    assert(Logic.swipe(p,Catalog[1].id,"classic",true,1000,{acceptance=0,timing=0,delay=0}))
    local key = Logic.key(Catalog[1].id,"classic")
    for stage=1,3 do assert(Logic.finishStage(p,key,stage,1,1000+stage)) end
    assert(Logic.recordSelfie(p,key,"cafe",123,"{\"version\":1}",1005))
    local history,revision = encoded(p.album),p.revision
    assert(Logic.validSavedProfile(p))
    local loaded = Logic.normalizeProfile(p,2000)
    assert(loaded.preferences.soundEnabled and loaded.preferences.motionEnabled)
    assert(encoded(loaded.album)==history and loaded.revision==revision and loaded.totalLikes==1)
end)
test("Both disabled preferences survive a real JSON profile roundtrip",function()
    local p = Logic.newProfile(1)
    assert(Logic.setPreferences(p,{soundEnabled=false,motionEnabled=false}))
    local loaded = Logic.normalizeProfile(serde.decode("json",encoded(p)),10)
    assert(Logic.validSavedProfile(loaded) and loaded.revision==1)
    local public = Logic.publicSnapshot(loaded,10)
    assert(public.preferences.soundEnabled==false and public.preferences.motionEnabled==false)
end)
test("A partial preference change preserves the other setting and gameplay",function()
    local p = Logic.newProfile(1)
    assert(Logic.setPreferences(p,{motionEnabled=false}))
    assert(Logic.setPreferences(p,{soundEnabled=false}))
    assert(Logic.setPreferences(p,{soundEnabled=true}))
    assert(p.preferences.soundEnabled and p.preferences.motionEnabled==false and p.revision==3)
    assert(p.totalLikes==0 and p.totalPasses==0 and next(p.matches)==nil)
end)
test("Repeated and empty updates do not create extra profile revisions",function()
    local p = Logic.newProfile(1)
    Logic.setPreferences(p,{soundEnabled=false})
    local before = encoded(p)
    assert(Logic.setPreferences(p,{soundEnabled=false}) and Logic.setPreferences(p,{}))
    assert(encoded(p)==before)
end)
test("Unknown keys and non-boolean patches are rejected atomically",function()
    for _,patch in {{soundEnabled="false"},{motionEnabled=0},{soundEnabled=false,totalLikes=99},false,"quiet"} do
        local p = Logic.newProfile(1); local before = encoded(p)
        local ok,err = Logic.setPreferences(p,patch)
        assert(not ok and err=="invalid_request" and encoded(p)==before)
    end
end)
test("Malformed nonessential settings normalize without discarding a profile",function()
    local p = Logic.newProfile(1)
    p.preferences = {soundEnabled=false,motionEnabled="yes",unexpected=true}
    assert(Logic.validSavedProfile(p))
    local loaded = Logic.normalizeProfile(p,2)
    assert(loaded.preferences.soundEnabled==false and loaded.preferences.motionEnabled)
    assert(loaded.preferences.unexpected==nil)
end)
test("A public snapshot cannot mutate stored preferences",function()
    local p = Logic.newProfile(1)
    local public = Logic.publicSnapshot(p,1)
    public.preferences.soundEnabled=false
    assert(p.preferences.soundEnabled)
end)
test("A click made before profile loading overrides the later saved value",function()
    local s = Preferences.new()
    Preferences.choose(s,"soundEnabled",false)
    Preferences.receive(s,{soundEnabled=true,motionEnabled=false})
    local effective = Preferences.effective(s)
    assert(effective.soundEnabled==false and effective.motionEnabled==false)
end)
test("A stale acknowledgement cannot overwrite a newer click",function()
    local s = Preferences.new()
    Preferences.choose(s,"soundEnabled",false)
    local changes,receipt = Preferences.request(s)
    Preferences.choose(s,"soundEnabled",true)
    Preferences.receive(s,changes); Preferences.acknowledge(s,receipt)
    assert(Preferences.effective(s).soundEnabled==true)
    local nextChanges,nextReceipt = Preferences.request(s)
    assert(nextChanges.soundEnabled==true)
    Preferences.receive(s,nextChanges); Preferences.acknowledge(s,nextReceipt)
    assert(next(s.pending)==nil and s.confirmed.soundEnabled)
end)
test("An in-flight sound save cannot clear a newer motion change",function()
    local s = Preferences.new()
    Preferences.choose(s,"soundEnabled",false)
    local changes,receipt = Preferences.request(s)
    Preferences.choose(s,"motionEnabled",false)
    Preferences.receive(s,changes); Preferences.acknowledge(s,receipt)
    local pending = Preferences.request(s)
    assert(pending.soundEnabled==nil and pending.motionEnabled==false)
    local effective = Preferences.effective(s)
    assert(effective.soundEnabled==false and effective.motionEnabled==false)
end)
test("A lost response keeps the local choice and can be retried idempotently",function()
    local s,p = Preferences.new(),Logic.newProfile(1)
    Preferences.choose(s,"soundEnabled",false)
    local changes = Preferences.request(s)
    assert(Logic.setPreferences(p,changes))
    -- The first response is lost; no acknowledgement is delivered.
    Preferences.receive(s,{soundEnabled=true,motionEnabled=true})
    assert(Preferences.effective(s).soundEnabled==false)
    local retry,receipt = Preferences.request(s)
    assert(Logic.setPreferences(p,retry) and p.revision==1)
    Preferences.receive(s,Logic.publicSnapshot(p,2).preferences)
    Preferences.acknowledge(s,receipt)
    assert(next(s.pending)==nil and Preferences.effective(s).soundEnabled==false)
end)
test("Rapid on-off clicks retain the final intent through an earlier response",function()
    local s = Preferences.new()
    Preferences.choose(s,"motionEnabled",false)
    local changes,receipt = Preferences.request(s)
    Preferences.choose(s,"motionEnabled",true); Preferences.choose(s,"motionEnabled",false)
    Preferences.receive(s,changes); Preferences.acknowledge(s,receipt)
    assert(Preferences.effective(s).motionEnabled==false)
    local final,finalReceipt = Preferences.request(s)
    assert(final.motionEnabled==false)
    Preferences.receive(s,final); Preferences.acknowledge(s,finalReceipt)
    assert(next(s.pending)==nil)
end)

fs.writeFile("prototype/evidence/preferences-tests.json",serde.encode("json",{passed=#tests,tests=tests},true))
print("Passed " .. #tests .. " preference persistence and race tests")
