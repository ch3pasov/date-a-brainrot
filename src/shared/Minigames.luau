Games.callSpeed = 0.62
function Games.callPosition(elapsed, phase)
    local position = (elapsed * Games.callSpeed + phase) % 2
    return position <= 1 and position or 2 - position
end
function Games.callNextTarget(elapsed, phase)
    local position = (elapsed * Games.callSpeed + phase) % 2
    return math.min((0.5 - position + 2) % 2, (1.5 - position + 2) % 2) / Games.callSpeed
end
function Games.callHit(elapsed, phase) return math.abs(Games.callPosition(elapsed, phase) - 0.5) <= 0.16 end
