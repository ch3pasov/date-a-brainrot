-- Name the exact prompt being answered. Retrying a lost response must not
-- apply the old choice to a new prompt.
function Games.turn(session)
    return session.stage == 2 and session.attempts + 1 or session.step
end
function Games.applyInput(session, args, now)
    if not session or args.token ~= session.token then return { error = "expired_game" } end
    if type(args.turn) ~= "number" or args.turn % 1 ~= 0 or args.turn < 1 then return { error = "invalid_request" } end
    if args.turn ~= Games.turn(session) then return { resynced = true } end
    if type(args.choice) ~= "number" and type(args.choice) ~= "string" then return { error = "invalid_choice" } end
    local index = tonumber(args.choice)
    local maximum = session.stage == 3 and 4 or (session.stage == 2 and #Locations.gestures or 3)
    if not index or index % 1 ~= 0 or index < 1 or index > maximum then return { error = "invalid_choice" } end
    local good, response, score
    if session.stage == 1 then
        local q = session.chat[session.step]
        good = index == q.best
        response = good and q.response or Games.chatMiss(session.personality, session.step)
        table.insert(session.messages, { from = "npc", text = q.prompt })
        table.insert(session.messages, { from = "player", text = q.options[index] })
        table.insert(session.messages, { from = "npc", text = response })
        table.insert(session.hits, good)
        if good then session.correct += 1 end
        session.step += 1
        if session.step > #session.chat then score = session.correct / #session.chat end
    elseif session.stage == 2 then
        local elapsed = now.server - session.serverStart
        if session.lastHit and elapsed - session.lastHit < .30 then return { error = "too_fast" } end
        session.lastHit = elapsed
        good = index == Locations.gesture(session.attempts + 1, session.gestureSeed)
        table.insert(session.hits, good)
        session.attempts += 1
        if good then session.correct += 1 end
        response = Games.reaction(session.personality, good, session.attempts)
        if session.attempts >= 6 then score = session.correct / 6 end
    else
        if now.clock - session.started < (session.revealSeconds or 3) then return { error = "memorize_first" } end
        good = index == Remix.answer(session.sequence, session.remixId, session.step)
        table.insert(session.choices, index); table.insert(session.hits, good)
        if good then session.correct += 1 end
        session.step += 1
        response = Games.dateReaction(session.personality, good)
        if session.step > #session.sequence then score = session.correct / #session.sequence end
    end
    return { good = good, response = response, score = score }
end
return Games
