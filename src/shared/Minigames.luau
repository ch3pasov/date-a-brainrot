local function shuffler(seed)
    local value = math.floor(tonumber(seed) or 1) % 2147483647
    if value < 1 then value = 1 end
    return function(maximum) value = (value * 48271) % 2147483647; return value % maximum + 1 end
end
local function mix(q, draw)
    local options = {}
    for i, text in q.options do options[i] = { text = text, good = i == q.best } end
    for i = #options, 2, -1 do local j = draw(i); options[i], options[j] = options[j], options[i] end
    local out = { prompt = q.prompt, options = {}, response = q.response }
    for i, option in options do out.options[i] = option.text; if option.good then out.best = i end end
    return out
end
function Games.chatFor(character, seed)
    local draw = shuffler(seed)
    local alternatives = ({
        food = { "Сначала пусть тост прочитает нам лекцию.", "Назначим печенье официальным ведущим знакомства." },
        music = { "Попросим ритм заполнить заявление в трёх экземплярах.", "Устроим сольный концерт холодильника прямо сейчас." },
        nature = { "Запишем каждую лужу в отдельный строгий журнал.", "Пусть облако сначала подготовит сорок слайдов." },
        adventure = { "Отправим компас в отпуск без обратного билета.", "Попросим рюкзак самому выбрать всех участников." },
        art = { "Мой ластик уже приготовил строгую систему оценок.", "Сначала покрасим все вопросы в одинаковый серый." },
        humor = { "Начнём с официальной презентации на сорок слайдов.", "Подожди, мой чайник хочет познакомиться первым." },
    })[character.personality] or { "Сначала познакомимся по очень строгому расписанию.", "Подожди, мой чайник хочет познакомиться первым." }
    local intro = question(character.opening or "Привет! Какой сегодня вайб?", character.answer or "Давай узнаем вместе.", alternatives[1], alternatives[2], character.reply or "Отлично. Уже улыбаюсь!")
    local bank = banks[character.personality] or banks.humor
    local order = {}; for i = 1, #bank do order[i] = i end
    for i = #order, 2, -1 do local j = draw(i); order[i], order[j] = order[j], order[i] end
    local out = { mix(intro, draw) }
    for i = 1, 3 do table.insert(out, mix(bank[order[i]], draw)) end
    return out
end
